{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["scripts", "core", "app/jeu.ts", "app/defi.ts", "app/badges.ts", "app/badges.test.ts", "app/pages/donnees.ts", "app/defi.test.ts", "app/stockage.ts", "app/paquet.ts", "app/libelles.ts", "app/jeu.test.ts", "app/donnees", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}
